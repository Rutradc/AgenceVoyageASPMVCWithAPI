<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Agence de Voyage</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DemoUser.ASP.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav>
            <a asp-action="Index" asp-controller="Home">Accueil</a>
            <a asp-action="Index" asp-controller="Destination">Destinations</a>
            <a asp-action="Create" asp-controller="Destination">Ajouter Destination</a>
            <a asp-action="Create" asp-controller="Activity">Ajouter Activité</a>
            <a href="reservations.html">Réservations</a>
            <a href="reservation.html">Faire Réservation</a>
        </nav>
    </header>

    <main role="main" class="pb-3">
        @RenderBody()
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

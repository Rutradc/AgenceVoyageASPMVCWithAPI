@model AppAgency.ASP.Models.CreateDestinationForm

@{
    ViewData["Title"] = "Ajouter Destination";
}

<h2>Ajouter une destination</h2>

<form asp-action="Create">
    <label for="Country">Entrez le pays</label>
    <input asp-for="Country"/>
    <span asp-validation-for="Country" class="text-danger"></span>

    <label for="City">Entrez le nom de la destination</label>
    <input asp-for="City"/>
    <span asp-validation-for="City" class="text-danger"></span>

    <label for="Description">Entrez une description</label>
    <textarea asp-for="Description"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>

    <button type="submit" value="Create">Ajouter</button>
</form>

<div>
    <a asp-action="Index">Back to List</a>
</div>


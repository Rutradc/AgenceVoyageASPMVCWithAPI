@model IEnumerable<AppAgency.ASP.Models.DisplayDestination>

@{
    ViewData["Title"] = "Destinations";
}

<h2>Liste des destinations</h2>

@foreach(DisplayDestination destination in Model)
{
    <div class="card">
        <h3>@destination.Country - @destination.City</h3>
        <p>@destination.Description</p>
        <a asp-action="Details" asp-controller="Destination">Voir détails</a>
    </div>    
}

